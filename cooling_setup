#!/usr/bin/env bash
# Set up fan control on a fresh Arch (or CachyOS) install of this machine:
#   - MSI MAG B660M MORTAR (MS-7D42) fan controller driver (nct6687d, DKMS)
#   - CoolerControl
#   - the backed-up CoolerControl config in ./coolercontrol/
#
# Run as your normal user (AUR packages can't be built as root); sudo is used where needed.
# Safe to re-run.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
backup="$here/coolercontrol"
config_files=(config.toml calibrations.json overrides.toml modes.json alerts.json config-ui.json)
expected_board="MS-7D42"

info() { printf '\n\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarning:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }
in_repos() { pacman -Si "$1" &>/dev/null; }

[[ $EUID -ne 0 ]] || die "run this as your normal user, not root (sudo is used where needed)"
command -v pacman >/dev/null || die "pacman not found: this script is for Arch-based systems"
for f in "${config_files[@]}"; do
    [[ -f "$backup/$f" ]] || die "missing backup file: $backup/$f"
done

# --- Sanity check: the configs and driver are specific to this board ---------------------------
board=$(cat /sys/class/dmi/id/board_name 2>/dev/null || echo unknown)
if [[ $board != *"$expected_board"* ]]; then
    warn "this board is '$board', the backup was made on '$expected_board'"
    read -rp "Continue anyway? [y/N] " answer
    [[ $answer == [yY]* ]] || exit 1
fi

sudo -v

# --- Build tools and kernel headers (DKMS needs headers for every installed kernel) ------------
info "Installing build tools and kernel headers"
packages=(base-devel git dkms)
for pkgbase in /usr/lib/modules/*/pkgbase; do
    [[ -f $pkgbase ]] || continue
    headers="$(cat "$pkgbase")-headers"
    if in_repos "$headers"; then
        packages+=("$headers")
    else
        warn "no headers package '$headers' found, the driver won't be built for that kernel"
    fi
done
sudo pacman -Syu --needed --noconfirm "${packages[@]}"
[[ -d /usr/lib/modules/$(uname -r) ]] || die "the kernel was just updated: reboot and re-run this script"

# --- AUR helper ---------------------------------------------------------------------------------
if command -v paru >/dev/null; then
    aur=paru
elif command -v yay >/dev/null; then
    aur=yay
elif in_repos paru; then
    info "Installing paru"
    sudo pacman -S --needed --noconfirm paru
    aur=paru
else
    info "Building paru-bin from the AUR"
    tmp=$(mktemp -d)
    git clone --depth 1 https://aur.archlinux.org/paru-bin.git "$tmp/paru-bin"
    (cd "$tmp/paru-bin" && makepkg -si --noconfirm)
    rm -rf "$tmp"
    aur=paru
fi

# --- Motherboard fan controller driver ----------------------------------------------------------
# The in-kernel nct6683 driver can read the NCT6687D but can't set fan speeds on MSI boards.
info "Installing the nct6687d driver"
$aur -S --needed --noconfirm nct6687d-dkms-git

echo nct6687 | sudo tee /etc/modules-load.d/nct6687.conf >/dev/null
echo "blacklist nct6683" | sudo tee /etc/modprobe.d/nct6683-blacklist.conf >/dev/null

if lsmod | grep -q '^nct6683 '; then
    sudo modprobe -r nct6683 || warn "couldn't unload nct6683, a reboot will fix that"
fi
if ! sudo modprobe nct6687; then
    die "couldn't load nct6687. If dmesg mentions an ACPI resource conflict, add
       acpi_enforce_resources=lax to the kernel command line, reboot and re-run this script."
fi

nct=$(grep -lx nct6687 /sys/class/hwmon/*/name 2>/dev/null | head -1 || true)
[[ -n $nct && -e $(dirname "$nct")/pwm1 ]] || die "nct6687 loaded but no PWM outputs showed up"
echo "nct6687 driver loaded: $(dirname "$nct")"

# --- CoolerControl ------------------------------------------------------------------------------
info "Installing CoolerControl"
if in_repos coolercontrol; then
    sudo pacman -S --needed --noconfirm coolercontrol   # CachyOS repos
else
    $aur -S --needed --noconfirm coolercontrol
fi

if ! command -v nvidia-smi >/dev/null; then
    warn "nvidia-smi not found: install the NVIDIA driver (nvidia-utils) for GPU fan control"
fi

# --- Restore the CoolerControl config -----------------------------------------------------------
info "Restoring the CoolerControl config"
sudo systemctl stop coolercontrold 2>/dev/null || true

if sudo test -f /etc/coolercontrol/config.toml; then
    saved="/etc/coolercontrol.bak-$(date +%Y%m%d-%H%M%S)"
    sudo cp -a /etc/coolercontrol "$saved"
    echo "existing config saved to $saved"
fi
for f in "${config_files[@]}"; do
    sudo install -Dm644 -o root -g root "$backup/$f" "/etc/coolercontrol/$f"
done
# Empty the [devices] list: the daemon rewrites it at startup with the devices it detects,
# which the check below relies on.
sudo sed -i '/^\[devices\]$/,/^\[/{/^[0-9a-f]\{64\} = /d}' /etc/coolercontrol/config.toml

sudo systemctl enable --now coolercontrold

# --- Check the saved settings match this hardware ----------------------------------------------
# Device settings are keyed by IDs that CoolerControl derives from the hardware. If the daemon
# reports different IDs here, the fan profiles won't be applied to those devices.
info "Checking the restored settings match the detected devices"
saved_ids=$(sed -n 's/^\[device-settings\.\([0-9a-f]\{64\}\)\]$/\1/p' "$backup/config.toml")
detected=""
for _ in $(seq 30); do
    detected=$(sed -n '/^\[devices\]$/,/^\[/{s/^\([0-9a-f]\{64\}\) = .*/\1/p}' /etc/coolercontrol/config.toml)
    [[ -n $detected ]] && break
    sleep 1
done
missing=""
for id in $saved_ids; do
    grep -qx "$id" <<<"$detected" || missing+="$id "
done

systemctl is-active --quiet coolercontrold || die "coolercontrold isn't running, see: journalctl -u coolercontrold"
if [[ -z $detected ]]; then
    warn "couldn't verify the devices (the daemon hasn't listed them yet), check the fans in CoolerControl"
elif [[ -n $missing ]]; then
    warn "these devices from the backup weren't detected, their fan settings won't apply:"
    for id in $missing; do
        echo "  $id = $(sed -n "s/^$id = //p" "$backup/config.toml")"
    done
    warn "open CoolerControl and re-assign the profiles to those devices' fans"
else
    echo "all devices found, fan profiles applied"
fi

info "Done. Open CoolerControl to check the fans, and reboot once to confirm the driver loads on boot."
